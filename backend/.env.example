# Teamora backend environment — copy to `.env` and adjust.
# docker-compose.yml reads these via ${VAR} substitution.
# (.env is gitignored; .env.example is committed as the template.)
# For a real deployment see DEPLOY.md and docker-compose.prod.yml.

# ---- Postgres ----
POSTGRES_DB=teamora
POSTGRES_USER=teamora
POSTGRES_PASSWORD=teamora
# Host port mapped to the DB container's 5432 (5435 avoids clashing with
# other local Postgres instances on 5432-5434).
DB_HOST_PORT=5435

# ---- API ----
API_PORT=8080
# dev | production. production refuses to start with seeding on, an exposed
# reset code, a published JWT secret, or reset codes that only go to the log,
# and turns off the Swagger UI / API docs.
TEAMORA_ENV=dev
# Seed the demo companies + accounts (password "password") on first boot —
# idempotent, only runs on an empty DB. Set true on your own machine for demo data;
# never in production (refused there).
TEAMORA_SEED=false
# JWT signing secret — REQUIRED, at least 32 bytes. The API refuses to start
# without one. Generate a real one with:  openssl rand -base64 48
# (This placeholder is accepted in dev and refused when TEAMORA_ENV=production.)
TEAMORA_JWT_SECRET=REPLACE_ME_with_output_of__openssl_rand_-base64_48
# Comma-separated allowed CORS origins (credentials allowed), or * for any
# origin (credentials NOT allowed). The mobile app doesn't need CORS.
TEAMORA_CORS_ORIGINS=*

# ---- Password reset ----
# false → POST /api/auth/forgot-password still answers 200 but creates and
# sends nothing. Production needs this false until a real email sender exists
# (the built-in sender only writes codes to the server log).
PASSWORD_RESET_ENABLED=true
# LOCAL DEV ONLY: returns the one-time password-reset code in the forgot-password
# response (`devCode`) so the flow can be tested before an email provider is wired up.
# NEVER true on a real deployment — it lets anyone reset any account (refused in production).
PASSWORD_RESET_EXPOSE_CODE=false

# ---- pgAdmin ----
PGADMIN_EMAIL=admin@teamora.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
