# Teamora backend environment — copy to `.env` and adjust.
# docker-compose.yml reads these via ${VAR} substitution.
# (.env is gitignored; .env.example is committed as the template.)

# ---- Postgres ----
POSTGRES_DB=teamora
POSTGRES_USER=teamora
POSTGRES_PASSWORD=teamora
# Host port mapped to the DB container's 5432 (5435 avoids clashing with
# other local Postgres instances on 5432-5434).
DB_HOST_PORT=5435

# ---- API ----
API_PORT=8080
# Seed demo data on first boot (idempotent — only runs on an empty DB).
TEAMORA_SEED=true
# JWT signing secret — MUST be >= 256 bits and changed for any real deployment.
TEAMORA_JWT_SECRET=change-me-in-prod-this-is-a-dev-only-256-bit-secret-key-0123456789
# Comma-separated allowed CORS origins, or * for any (dev only).
TEAMORA_CORS_ORIGINS=*

# ---- pgAdmin ----
PGADMIN_EMAIL=admin@teamora.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
